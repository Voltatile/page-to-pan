<!--
  A small note that stands beside the plate once the dish is served: how to
  cook the same dish in a real kitchen. Authored at 1 unit = 1 mm (placed at
  scale 0.1): a 26 cm wide note with 24-unit body text, read from about 0.7 m.
  Note: comments inside the style block break the UIKitML parser.
-->
<style>
  .note {
    flex-direction: column;
    width: 260px;
    padding-top: 12px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    gap: 6px;
    background-color: #f6f0e2;
    border-color: #c9893a;
    border-width: 2px;
    border-radius: 14px;
    render-order: 7;
  }

  .note-heading {
    color: #8a5a14;
    font-size: 26px;
    font-weight: 700;
  }

  .note-heading:dark {
    color: #8a5a14;
  }

  .note-text {
    color: #3a3b40;
    font-size: 24px;
    line-height: 1.3;
  }

  .note-text:dark {
    color: #3a3b40;
  }
</style>
<div class="note">
  <div class="note-heading">Try it at home</div>
  <div id="home-note-text" class="note-text">2 eggs, a pinch of salt, a knob of butter.</div>
</div>
