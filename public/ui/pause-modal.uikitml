<!--
  Pause pop-up modal covering the center of the view when the game is paused.
  Provides Resume, Settings (inline), and Exit Game.
  Note: comments inside the style block break the UIKitML parser.
-->
<style>
  .pause-modal {
    flex-direction: column;
    justify-content: space-between;
    width: 460px;
    height: 240px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: #1e2026;
    border-color: #c9893a;
    border-width: 3px;
    border-radius: 20px;
    render-order: 15;
  }

  .pause-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .pause-title {
    color: #fafaf7;
    font-size: 38px;
    font-weight: 700;
  }

  .pause-title:dark {
    color: #fafaf7;
  }

  .pause-subtitle {
    color: #d8ceb8;
    font-size: 22px;
    line-height: 1.25;
  }

  .pause-subtitle:dark {
    color: #d8ceb8;
  }

  .pause-divider {
    height: 2px;
    background-color: #c9893a;
  }

  .pause-actions {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pause-btn {
    width: 128px;
    height: 64px;
    justify-content: center;
  }

  .pause-btn-label {
    font-size: 24px;
  }

  .pause-settings-panel {
    flex-direction: column;
    gap: 12px;
  }

  .pause-settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .pause-step-btn {
    width: 54px;
    height: 54px;
    justify-content: center;
  }

  .pause-step-btn-label {
    font-size: 28px;
  }

  .pause-vol-label {
    width: 140px;
    color: #fafaf7;
    font-size: 22px;
    text-align: center;
  }

  .pause-vol-label:dark {
    color: #fafaf7;
  }

  .pause-sub-btn {
    height: 54px;
    padding-left: 12px;
    padding-right: 12px;
    justify-content: center;
  }

  .pause-sub-btn-label {
    font-size: 20px;
  }
</style>
<div id="pause-card" class="pause-modal">
  <div class="pause-header">
    <div id="pause-title" class="pause-title">Game Paused</div>
  </div>
  <div id="pause-subtitle" class="pause-subtitle">Take a breath. The pan waits for you.</div>
  <div class="pause-divider"></div>
  <div id="pause-main-actions" class="pause-actions">
    <Button id="pause-resume" class="pause-btn">
      <ButtonLabel class="pause-btn-label">Resume</ButtonLabel>
    </Button>
    <Button id="pause-settings" class="pause-btn">
      <ButtonLabel class="pause-btn-label">Settings</ButtonLabel>
    </Button>
    <Button id="pause-exit" class="pause-btn">
      <ButtonLabel class="pause-btn-label">Exit Game</ButtonLabel>
    </Button>
  </div>
  <div id="pause-settings-actions" class="pause-settings-panel">
    <div class="pause-settings-row">
      <Button id="pause-vol-down" class="pause-step-btn">
        <ButtonLabel class="pause-step-btn-label">-</ButtonLabel>
      </Button>
      <div id="pause-vol-text" class="pause-vol-label">Vol 90%</div>
      <Button id="pause-vol-up" class="pause-step-btn">
        <ButtonLabel class="pause-step-btn-label">+</ButtonLabel>
      </Button>
      <Button id="pause-recenter" class="pause-sub-btn">
        <ButtonLabel class="pause-sub-btn-label">Recenter</ButtonLabel>
      </Button>
      <Button id="pause-voice-toggle" class="pause-sub-btn">
        <ButtonLabel id="pause-voice-label" class="pause-sub-btn-label">Voice: Off</ButtonLabel>
      </Button>
      <Button id="pause-settings-back" class="pause-sub-btn">
        <ButtonLabel class="pause-sub-btn-label">Back</ButtonLabel>
      </Button>
    </div>
  </div>
</div>
