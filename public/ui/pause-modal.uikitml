<!--
  Pause pop-up modal covering the center of the view when the game is paused.
  Provides Resume, Settings (inline), and Exit Game.
  Note: comments inside the style block break the UIKitML parser.
-->
<style>
  .modal {
    flex-direction: column;
    justify-content: space-between;
    width: 460px;
    height: 240px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: #1e2026;
    border-color: #c9893a;
    border-width: 3px;
    border-radius: 20px;
  }

  .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .title {
    color: #fafaf7;
    font-size: 42px;
    font-weight: 700;
  }

  .title:dark {
    color: #fafaf7;
  }

  .subtitle {
    color: #d8ceb8;
    font-size: 24px;
    line-height: 1.3;
  }

  .subtitle:dark {
    color: #d8ceb8;
  }

  .divider {
    height: 2px;
    background-color: #c9893a;
  }

  .actions {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .modal-btn {
    width: 128px;
    height: 68px;
    justify-content: center;
  }

  .modal-btn-label {
    font-size: 24px;
  }

  .settings-panel {
    flex-direction: column;
    gap: 12px;
  }

  .settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .step-btn {
    width: 54px;
    height: 54px;
    justify-content: center;
  }

  .step-btn-label {
    font-size: 28px;
  }

  .vol-label {
    width: 150px;
    color: #fafaf7;
    font-size: 24px;
    text-align: center;
  }

  .vol-label:dark {
    color: #fafaf7;
  }

  .sub-btn {
    height: 54px;
    padding-left: 14px;
    padding-right: 14px;
    justify-content: center;
  }

  .sub-btn-label {
    font-size: 22px;
  }
</style>
<div id="pause-card" class="modal">
  <div class="header">
    <div id="pause-title" class="title">Game Paused</div>
  </div>
  <div id="pause-subtitle" class="subtitle">Take a breath. The pan waits for you.</div>
  <div class="divider"></div>
  <div id="pause-main-actions" class="actions">
    <Button id="pause-resume" class="modal-btn">
      <ButtonLabel class="modal-btn-label">Resume</ButtonLabel>
    </Button>
    <Button id="pause-settings" class="modal-btn">
      <ButtonLabel class="modal-btn-label">Settings</ButtonLabel>
    </Button>
    <Button id="pause-exit" class="modal-btn">
      <ButtonLabel class="modal-btn-label">Exit Game</ButtonLabel>
    </Button>
  </div>
  <div id="pause-settings-actions" class="settings-panel">
    <div class="settings-row">
      <Button id="pause-vol-down" class="step-btn">
        <ButtonLabel class="step-btn-label">-</ButtonLabel>
      </Button>
      <div id="pause-vol-text" class="vol-label">Volume 90%</div>
      <Button id="pause-vol-up" class="step-btn">
        <ButtonLabel class="step-btn-label">+</ButtonLabel>
      </Button>
      <Button id="pause-recenter" class="sub-btn">
        <ButtonLabel class="sub-btn-label">Recenter</ButtonLabel>
      </Button>
      <Button id="pause-voice-toggle" class="sub-btn">
        <ButtonLabel id="pause-voice-label" class="sub-btn-label">Voice: Off</ButtonLabel>
      </Button>
      <Button id="pause-settings-back" class="sub-btn">
        <ButtonLabel class="sub-btn-label">Back</ButtonLabel>
      </Button>
    </div>
  </div>
</div>
