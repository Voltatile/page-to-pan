<!--
  Authored in pixel-like units and placed at scale 0.1, so 1 unit is 1 mm:
  this 480 x 252 card is 48 x 25.2 cm. Viewed from about 0.85 m, the 26-unit
  body text and the 24-unit tip text meet the 24-32 px readability rule.
  The buttons are 12 x 7.2 cm, sized for shaky hand rays: the card leans back
  45 degrees, so their height is the side that looks smallest.
  The bottom strip shows why the step matters, the menu on the title card, or the
  score breakdown at the end.
  Note: comments inside the style block break the UIKitML parser.
-->
<style>
  .card {
    flex-direction: column;
    width: 480px;
    height: 252px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 20px;
    padding-right: 20px;
    gap: 6px;
    background-color: #f6f0e2;
    border-color: #d8ceb8;
    border-width: 2px;
    border-radius: 16px;
    render-order: 5;
  }

  .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .title {
    color: #1c1d20;
    font-size: 46px;
    font-weight: 700;
    line-height: 1.2;
  }

  .title:dark {
    color: #1c1d20;
  }

  .buttons {
    flex-direction: row;
    gap: 10px;
  }

  .card-button {
    width: 120px;
    height: 72px;
    justify-content: center;
  }

  .card-button-label {
    font-size: 28px;
  }

  .instruction {
    color: #3a3b40;
    font-size: 26px;
    line-height: 1.3;
    height: 68px;
  }

  .instruction:dark {
    color: #3a3b40;
  }

  .strip {
    flex-direction: column;
    gap: 8px;
  }

  .divider {
    height: 2px;
    background-color: #c9893a;
  }

  .tip {
    color: #8a5a14;
    font-size: 24px;
    line-height: 1.3;
  }

  .tip:dark {
    color: #8a5a14;
  }

  .menu {
    flex-direction: row;
    gap: 8px;
  }

  .menu-button {
    height: 54px;
    padding-left: 10px;
    padding-right: 10px;
    justify-content: center;
  }

  .menu-button-label {
    font-size: 20px;
  }

  .settings {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .step-button {
    width: 50px;
    height: 54px;
    justify-content: center;
  }

  .step-button-label {
    font-size: 28px;
  }

  .settings-value {
    width: 132px;
    color: #3a3b40;
    font-size: 22px;
    text-align: center;
  }

  .settings-value:dark {
    color: #3a3b40;
  }

  .stats {
    flex-direction: row;
    justify-content: space-between;
  }

  .stat {
    flex-direction: column;
    align-items: center;
    width: 125px;
  }

  .stat-value {
    color: #8a5a14;
    font-size: 32px;
    font-weight: 700;
  }

  .stat-value:dark {
    color: #8a5a14;
  }

  .stat-label {
    color: #3a3b40;
    font-size: 24px;
  }

  .stat-label:dark {
    color: #3a3b40;
  }
</style>
<div class="card">
  <div class="header">
    <div id="recipe-title" class="title">Omelette</div>
    <div class="buttons">
      <Button id="card-button-secondary" class="card-button">
        <ButtonLabel id="card-button-secondary-label" class="card-button-label">Restart</ButtonLabel>
      </Button>
      <Button id="card-button" class="card-button">
        <ButtonLabel id="card-button-label" class="card-button-label">Enter VR</ButtonLabel>
      </Button>
    </div>
  </div>
  <div id="recipe-instruction" class="instruction">Place each ingredient on its outline.</div>
  <div id="card-strip" class="strip">
    <div class="divider"></div>
    <div id="card-tip" class="tip">Why: having everything within reach keeps you calm.</div>
    <div id="card-menu" class="menu">
      <Button id="menu-how-to-play" class="menu-button">
        <ButtonLabel class="menu-button-label">How to Play</ButtonLabel>
      </Button>
      <Button id="menu-mode-toggle" class="menu-button">
        <ButtonLabel id="menu-mode-label" class="menu-button-label">Mode: Guided</ButtonLabel>
      </Button>
      <Button id="menu-settings" class="menu-button">
        <ButtonLabel class="menu-button-label">Settings</ButtonLabel>
      </Button>
      <Button id="menu-credits" class="menu-button">
        <ButtonLabel class="menu-button-label">Credits</ButtonLabel>
      </Button>
    </div>
    <div id="card-settings" class="settings">
      <Button id="settings-volume-down" class="step-button">
        <ButtonLabel class="step-button-label">-</ButtonLabel>
      </Button>
      <div id="settings-volume" class="settings-value">Volume 90%</div>
      <Button id="settings-volume-up" class="step-button">
        <ButtonLabel class="step-button-label">+</ButtonLabel>
      </Button>
      <Button id="settings-recenter" class="menu-button">
        <ButtonLabel class="menu-button-label">Recenter</ButtonLabel>
      </Button>
      <Button id="settings-voice-toggle" class="menu-button">
        <ButtonLabel id="settings-voice-label" class="menu-button-label">Voice: Off</ButtonLabel>
      </Button>
    </div>
    <div id="card-stats" class="stats">
      <div class="stat">
        <div id="stat-accuracy" class="stat-value">100</div>
        <div class="stat-label">Seasoning</div>
      </div>
      <div class="stat">
        <div id="stat-timing" class="stat-value">100</div>
        <div class="stat-label">Timing</div>
      </div>
      <div class="stat">
        <div id="stat-technique" class="stat-value">100</div>
        <div class="stat-label">Technique</div>
      </div>
    </div>
  </div>
</div>
