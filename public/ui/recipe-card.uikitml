<!--
  Authored in pixel-like units and placed at scale 0.1, so 1 unit is 1 mm:
  this 480 x 240 card is 48 x 24 cm. Viewed from about 0.85 m, the 26-unit
  body text and the 24-unit tip text meet the 24-32 px readability rule.
  The buttons are about 13 x 6 cm, sized for shaky hand rays.
  The bottom strip shows why the step matters, or the score breakdown at the end.
  Note: comments inside the style block break the UIKitML parser.
-->
<style>
  .card {
    flex-direction: column;
    width: 480px;
    height: 240px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 20px;
    padding-right: 20px;
    gap: 6px;
  }

  .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .title {
    color: #1c1d20;
    font-size: 46px;
    font-weight: 700;
    line-height: 1.2;
  }

  .title:dark {
    color: #fafaf7;
  }

  .buttons {
    flex-direction: row;
    gap: 10px;
  }

  .card-button {
    width: 130px;
    height: 60px;
    justify-content: center;
  }

  .card-button-label {
    font-size: 26px;
  }

  .instruction {
    color: #3a3b40;
    font-size: 26px;
    line-height: 1.3;
    height: 68px;
  }

  .instruction:dark {
    color: #eceef2;
  }

  .strip {
    flex-direction: column;
    gap: 8px;
  }

  .divider {
    height: 2px;
    background-color: #c9893a;
  }

  .tip {
    color: #8a5a14;
    font-size: 24px;
    line-height: 1.3;
  }

  .tip:dark {
    color: #ffc46b;
  }

  .stats {
    flex-direction: row;
    justify-content: space-between;
  }

  .stat {
    flex-direction: column;
    align-items: center;
    width: 125px;
  }

  .stat-value {
    color: #8a5a14;
    font-size: 32px;
    font-weight: 700;
  }

  .stat-value:dark {
    color: #ffc46b;
  }

  .stat-label {
    color: #3a3b40;
    font-size: 24px;
  }

  .stat-label:dark {
    color: #eceef2;
  }
</style>
<Panel class="card">
  <div class="header">
    <div id="recipe-title" class="title">Omelette</div>
    <div class="buttons">
      <Button id="card-button-secondary" class="card-button">
        <ButtonLabel id="card-button-secondary-label" class="card-button-label">Restart</ButtonLabel>
      </Button>
      <Button id="card-button" class="card-button">
        <ButtonLabel id="card-button-label" class="card-button-label">Enter VR</ButtonLabel>
      </Button>
    </div>
  </div>
  <div id="recipe-instruction" class="instruction">Place each ingredient on its outline.</div>
  <div id="card-strip" class="strip">
    <div class="divider"></div>
    <div id="card-tip" class="tip">Why: having everything within reach keeps you calm.</div>
    <div id="card-stats" class="stats">
      <div class="stat">
        <div id="stat-accuracy" class="stat-value">100</div>
        <div class="stat-label">Seasoning</div>
      </div>
      <div class="stat">
        <div id="stat-timing" class="stat-value">100</div>
        <div class="stat-label">Timing</div>
      </div>
      <div class="stat">
        <div id="stat-technique" class="stat-value">100</div>
        <div class="stat-label">Technique</div>
      </div>
    </div>
  </div>
</Panel>
