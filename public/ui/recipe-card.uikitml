<!--
  Authored in pixel-like units and placed at scale 0.1, so 1 unit is 1 mm:
  this 440 x 165 card is 44 x 16.5 cm. Viewed from about 0.85 m, the 26-unit
  body text meets the 24-32 px readability rule.
-->
<style>
  .card {
    flex-direction: column;
    width: 440px;
    height: 165px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 20px;
    padding-right: 20px;
    gap: 6px;
  }

  .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .title {
    color: #1c1d20;
    font-size: 46px;
    font-weight: 700;
    line-height: 1.2;
  }

  .title:dark {
    color: #fafaf7;
  }

  .instruction {
    color: #3a3b40;
    font-size: 26px;
    line-height: 1.3;
  }

  .instruction:dark {
    color: #eceef2;
  }
</style>
<Panel class="card">
  <div class="header">
    <div id="recipe-title" class="title">Omelette</div>
    <Button id="enter-vr-button">
      <ButtonLabel>Enter VR</ButtonLabel>
    </Button>
  </div>
  <div id="recipe-instruction" class="instruction">Place each ingredient on its outline.</div>
</Panel>
